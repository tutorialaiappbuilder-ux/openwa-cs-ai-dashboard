# ============================================
# OpenWA CS AI Gateway — Environment Variables
# ============================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai.

# ---- Neon Database ----
# Dapatkan di: https://neon.tech → Project Settings → Connection String
DATABASE_URL=postgresql://user:password@ep-xxxx.region.neon.tech/dbname?sslmode=require

# ---- Google Gemini API ----
# Dapatkan di: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Cloudflare R2 (Opsional) ----
# Kosongkan jika belum setup — sistem akan fallback ke penyimpanan lokal /uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=openwa-storage

# ---- OpenWA Bridge ----
# URL backend API yang menerima webhook dari bridge
BACKEND_API_URL=http://localhost:4000
# Business ID default (UUID dari tabel businesses setelah seed)
DEFAULT_BUSINESS_ID=

# ---- Server ----
PORT=4000
NODE_ENV=development
